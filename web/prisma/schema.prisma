generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. USERS ---
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  fullName      String?
  role          Role         @default(STUDENT)
  createdAt     DateTime     @default(now())
  
  // Relations
  courses       Course[]     @relation("InstructorCourses")
  enrollments   Enrollment[]
  studyNotes    StudyNote[]
  quizzes       Quiz[]
}

// --- 2. MARKETPLACE ---
model Course {
  id            String       @id @default(uuid())
  instructorId  String
  title         String
  description   String?
  price         Decimal      @db.Decimal(10, 2)
  thumbnailUrl  String?
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())

  instructor    User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  lessons       Lesson[]
  enrollments   Enrollment[]
}

model Lesson {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  videoUrl    String
  duration    Int      // Saniye cinsinden
  orderIndex  Int

  course      Course   @relation(fields: [courseId], references: [id])
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  purchasedAt DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

// --- 3. AI & STUDY ---
enum NoteStatus {
  PENDING
  COMPLETED
  FAILED
}

model StudyNote {
  id              String           @id @default(uuid())
  studentId       String
  fileUrl         String
  fileName        String
  processedStatus NoteStatus       @default(PENDING)
  uploadedAt      DateTime         @default(now())

  student         User             @relation(fields: [studentId], references: [id])
  embeddings      NoteEmbedding[]
  quizzes         Quiz[]
}

// Vektör desteği için özel model (PostgreSQL pgvector gerektirir)
// Şimdilik standart tablo gibi tanımlıyoruz, vector tipi için raw SQL gerekecek.
model NoteEmbedding {
  id           String    @id @default(uuid())
  noteId       String
  contentChunk String
  // embedding vector(1536) -> Prisma henüz native vector desteklemiyor, bunu unsupported ile geçiyoruz
  embedding    Unsupported("vector(1536)")? 

  note         StudyNote @relation(fields: [noteId], references: [id])
}

model Quiz {
  id        String   @id @default(uuid())
  noteId    String
  studentId String
  score     Int?
  createdAt DateTime @default(now())

  note      StudyNote      @relation(fields: [noteId], references: [id])
  student   User           @relation(fields: [studentId], references: [id])
  questions QuizQuestion[]
}

model QuizQuestion {
  id            String @id @default(uuid())
  quizId        String
  questionText  String
  options       Json   // Şıklar: ["A", "B"]
  correctAnswer String
  userAnswer    String?

  quiz          Quiz   @relation(fields: [quizId], references: [id])
}