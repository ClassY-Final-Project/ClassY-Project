generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- 1. USERS ---
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  role         Role     @default(STUDENT)
  bio          String?
  avatarUrl    String?
  iban         String?
  createdAt    DateTime @default(now())

  // Relations
  courses                 Course[]               @relation("InstructorCourses")
  enrollments             Enrollment[]
  studyNotes              StudyNote[]
  quizzes                 Quiz[]
  assignedQuizzes         Quiz[]                 @relation("AssignedQuizzes")
  liveRoomsHosted         LiveRoom[]             @relation("InstructorRooms")
  roomParticipations      RoomParticipant[]
  subscriptions           Subscription[]         @relation("StudentSubscriptions")
  subscribers             Subscription[]         @relation("InstructorSubscribers")
  lessonProgress          LessonProgress[]
  reviews                 CourseReview[]
  notifications           Notification[]
  subjects                Subject[]
  studyRoomsCreated       StudyRoom[]            @relation("StudyRoomsCreated")
  studyRoomParticipations StudyRoomParticipant[]
  studyRoomMessages       StudyRoomMessage[]
}

// --- 2. MARKETPLACE ---
model Course {
  id           String   @id @default(uuid())
  instructorId String
  title        String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor  User            @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  sections    CourseSection[]
  lessons     Lesson[]
  enrollments Enrollment[]
  reviews     CourseReview[]

  @@index([instructorId])
  @@map("courses")
}

enum LessonContentType {
  VIDEO_URL
  UPLOADED_VIDEO
  PDF
  TEXT
  ASSIGNMENT_FILE
  ASSIGNMENT_TEXT
}

model CourseSection {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@unique([id, courseId])
  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id         String   @id @default(uuid())
  courseId   String
  sectionId  String
  title      String
  duration   Int?
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section  CourseSection    @relation(fields: [sectionId, courseId], references: [id, courseId], onDelete: Cascade)
  contents LessonContent[]
  progress LessonProgress[]

  @@unique([sectionId, orderIndex])
  @@index([courseId])
  @@index([sectionId])
  @@index([sectionId, courseId])
  @@map("lessons")
}

model LessonContent {
  id          String            @id @default(uuid())
  lessonId    String
  contentType LessonContentType
  title       String?
  assetUrl    String?
  textContent String?
  mimeType    String?
  duration    Int?
  orderIndex  Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([lessonId])
  @@map("lesson_contents")
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  purchasedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model LessonProgress {
  id          String   @id @default(uuid())
  studentId   String
  lessonId    String
  courseId    String
  completedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("LessonProgress")
}

model CourseReview {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@map("CourseReview")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Notification")
}

// --- 3. AI & STUDY ---
enum NoteStatus {
  PENDING
  COMPLETED
  FAILED
}

model StudyNote {
  id              String     @id @default(uuid())
  studentId       String
  fileUrl         String?
  fileName        String
  summary         String?
  processedStatus NoteStatus @default(PENDING)
  uploadedAt      DateTime   @default(now())
  subject         String     @default("Genel")
  weekId          String?

  student    User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  week       Week?       @relation(fields: [weekId], references: [id], onDelete: Cascade)
  quizzes    Quiz[]
  flashcards Flashcard[]

  @@index([weekId])
}

// Öğrenci tarafından eklenen "Ders" (örn. Matematik 12 hafta)
model Subject {
  id        String   @id @default(uuid())
  studentId String
  name      String
  weekCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weeks   Week[]

  @@index([studentId])
  @@map("subjects")
}

// Bir dersin haftaları
model Week {
  id         String   @id @default(uuid())
  subjectId  String
  weekNumber Int
  title      String?
  createdAt  DateTime @default(now())

  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  notes   StudyNote[]
  quizzes Quiz[]

  @@unique([subjectId, weekNumber])
  @@index([subjectId])
  @@map("weeks")
}

model Flashcard {
  id      String @id @default(uuid())
  noteId  String
  front   String
  back    String
  subject String @default("Genel")

  note StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model Quiz {
  id                     String   @id @default(uuid())
  noteId                 String?
  studentId              String
  subject                String   @default("Genel")
  title                  String
  score                  Int?
  createdAt              DateTime @default(now())
  assignedByInstructorId String?
  weekId                 String?

  note                 StudyNote?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student              User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedByInstructor User?          @relation("AssignedQuizzes", fields: [assignedByInstructorId], references: [id], onDelete: SetNull)
  week                 Week?          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  questions            QuizQuestion[]

  @@index([weekId])
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  questionText  String
  options       Json
  correctAnswer String
  userAnswer    String?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// --- 4. LIVE ROOMS ---
enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

model LiveRoom {
  id            String     @id @default(uuid())
  name          String
  dailyRoomName String     @unique
  instructorId  String
  status        RoomStatus @default(SCHEDULED)
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())

  instructor   User              @relation("InstructorRooms", fields: [instructorId], references: [id], onDelete: Cascade)
  participants RoomParticipant[]
}

model RoomParticipant {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

// --- 5. STUDY ROOMS ---
enum StudyRoomType {
  VOICE
  SILENT
}

model StudyRoom {
  id             String        @id @default(uuid())
  name           String
  topic          String?
  type           StudyRoomType @default(SILENT)
  createdById    String
  isActive       Boolean       @default(true)
  maxCapacity    Int           @default(20)
  dailyRoomName  String?       @unique
  expiresAt      DateTime?
  isPrivate      Boolean       @default(false)
  inviteCode     String?       @unique
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  createdAt      DateTime      @default(now())

  createdBy    User                   @relation("StudyRoomsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  participants StudyRoomParticipant[]
  messages     StudyRoomMessage[]

  @@map("study_rooms")
}

model StudyRoomMessage {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  room StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("study_room_messages")
}

model StudyRoomParticipant {
  id       String    @id @default(uuid())
  roomId   String
  userId   String
  studying String?
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  isActive Boolean   @default(true)

  room StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("study_room_participants")
}

// --- 6. SUBSCRIPTIONS ---
model Subscription {
  id           String   @id @default(uuid())
  studentId    String
  instructorId String
  subscribedAt DateTime @default(now())
  isPaid       Boolean  @default(false)

  student    User @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("InstructorSubscribers", fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([studentId, instructorId])
}
