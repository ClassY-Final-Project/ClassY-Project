generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 1. USERS ---
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  // Relations
  courses     Course[]     @relation("InstructorCourses")
  enrollments Enrollment[]
  studyNotes  StudyNote[]
  quizzes     Quiz[]
}

// --- 2. MARKETPLACE ---
model Course {
  id            String       @id @default(uuid())
  instructorId  String
  title         String
  description   String?
  price         Decimal      @db.Decimal(10, 2)
  thumbnailUrl  String?
  isPublished   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  instructor  User            @relation("InstructorCourses", fields: [instructorId], references: [id])
  sections    CourseSection[]
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([instructorId])
  @@map("courses")
}

enum LessonContentType {
  VIDEO_URL
  UPLOADED_VIDEO
  PDF
  TEXT
  ASSIGNMENT_FILE
  ASSIGNMENT_TEXT
}

model CourseSection {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, orderIndex])
  @@unique([id, courseId])
  @@index([courseId])
  @@map("course_sections")
}

model Lesson {
  id         String   @id @default(uuid())
  courseId   String
  sectionId  String
  title      String
  duration   Int? // Saniye cinsinden
  orderIndex Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section  CourseSection   @relation(fields: [sectionId, courseId], references: [id, courseId], onDelete: Cascade)
  contents LessonContent[]

  @@unique([sectionId, orderIndex])
  @@index([courseId])
  @@index([sectionId])
  @@index([sectionId, courseId])
  @@map("lessons")
}

model LessonContent {
  id          String            @id @default(uuid())
  lessonId    String
  contentType LessonContentType
  title       String?
  assetUrl    String?
  textContent String?
  mimeType    String?
  duration    Int?
  orderIndex  Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderIndex])
  @@index([lessonId])
  @@map("lesson_contents")
}

model Enrollment {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  purchasedAt DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

// --- 3. AI & STUDY ---
enum NoteStatus {
  PENDING
  COMPLETED
  FAILED
}

model StudyNote {
  id              String           @id @default(uuid())
  studentId       String
  fileUrl         String
  fileName        String
  processedStatus NoteStatus       @default(PENDING)
  uploadedAt      DateTime         @default(now())

  student    User        @relation(fields: [studentId], references: [id])
  quizzes    Quiz[]
}

model Quiz {
  id        String   @id @default(uuid())
  noteId    String
  studentId String
  score     Int?
  createdAt DateTime @default(now())

  note      StudyNote      @relation(fields: [noteId], references: [id])
  student   User           @relation(fields: [studentId], references: [id])
  questions QuizQuestion[]
}

model QuizQuestion {
  id            String @id @default(uuid())
  quizId        String
  questionText  String
  options       Json   // Şıklar: ["A", "B"]
  correctAnswer String
  userAnswer    String?

  quiz          Quiz   @relation(fields: [quizId], references: [id])
}